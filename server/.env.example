# Copy this file to `.env` and fill in the values. `.env` is ignored by git.

# PostgreSQL connection string.
# For Supabase: Project -> Connect -> "Session pooler" (host ends in
# pooler.supabase.com, port 5432). Use the session pooler locally, because
# migrations take a session-level lock that the transaction pooler does not support.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Optional. Schema the tables live in. Defaults to `public`.
# DATABASE_SCHEMA=public

# Optional. Port for the local API server. Defaults to 3000.
# PORT=3000

# The HR Manager account created by the seed script (npm run seed -w server).
SEED_HR_EMAIL=hr.manager@example.com
SEED_HR_PASSWORD=<at least 8 characters>
# Optional. Defaults to `HR Manager`.
# SEED_HR_NAME=HR Manager

# Signs the session cookie. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<long random string>
